{
  "name": "kakapo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "test": "vitest run",
    "preview": "wrangler dev -c dist/server/wrangler.json --local --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "export:wp": "tsx scripts/export-from-wp.ts",
    "migrate:wp": "tsx scripts/migrate-from-wp.ts",
    "verify:secrets": "tsx scripts/verify-no-secrets.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "astro": "7.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.152.0"
  }
}
