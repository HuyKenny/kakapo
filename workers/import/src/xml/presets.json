{
 "sdovolena_tours": {
  "mode": "product",
  "item": "tour",
  "default_type": "poznavaci",
  "fields": {
   "product.external_id": {
    "path": "tour_id"
   },
   "product.title": {
    "path": "tour_title",
    "transforms": [
     "trim"
    ]
   },
   "product.description": {
    "path": "tour_desc",
    "transforms": [
     "strip_tags",
     "trim"
    ]
   },
   "product.affiliate_url": {
    "path": "tour_detail_url"
   },
   "product._tour_type": {
    "path": "tour_type"
   },
   "product.country": {
    "path": "locations/location/country_id",
    "transforms": [
     "iso3_country"
    ]
   },
   "product.destination": {
    "path": "locations/location/area_title",
    "transforms": [
     "trim"
    ]
   },
   "product.place": {
    "path": "locations/location/place_title",
    "transforms": [
     "trim"
    ]
   },
   "product.images": {
    "paths": [
     "photos/photo/url",
     "photos/photo"
    ],
    "multiple": true
   },
   "product.price": {
    "path": "//final_price",
    "transforms": [
     "int"
    ],
    "multiple": true,
    "aggregate": "min"
   },
   "product.date_from": {
    "path": "//start",
    "transforms": [
     "ymd"
    ],
    "multiple": true,
    "aggregate": "min_future"
   },
   "product.dates": {
    "path": "//start",
    "transforms": [
     "ymd"
    ],
    "multiple": true
   },
   "product.nights": {
    "path": "//night_count",
    "transforms": [
     "int"
    ]
   }
  },
  "terms": {
   "item": "term",
   "fields": {
    "from": {
     "path": "start",
     "transforms": [
      "ymd"
     ]
    },
    "to": {
     "path": "end",
     "transforms": [
      "ymd"
     ]
    },
    "nights": {
     "path": "night_count",
     "transforms": [
      "int"
     ]
    },
    "price": {
     "path": "//final_price",
     "transforms": [
      "int"
     ],
     "multiple": true,
     "aggregate": "min"
    },
    "url": {
     "path": "purchase_url"
    }
   }
  }
 },
