 "slevomat_deals": {
  "mode": "product",
  "item": "DEAL",
  "default_type": "plavby",
  "force_type": "plavby",
  "product_filter": {
   "field": "_categories",
   "contains_any": [
    "Plavba lodí"
   ]
  },
  "fields": {
   "product.external_id": {
    "path": "ID"
   },
   "product.title": {
    "paths": [
     "TITLE_SHORT",
     "TITLE"
    ],
    "transforms": [
     "trim"
    ]
   },
   "product.description": {
    "paths": [
     "DESCRIPTION",
     "HIGHLIGHTS"
    ],
    "transforms": [
     "strip_tags",
     "trim"
    ]
   },
   "product.affiliate_url": {
    "path": "URL"
   },
   "product.price": {
    "path": "FINAL_PRICE",
    "transforms": [
     "int"
    ]
   },
   "product.price_original": {
    "path": "ORIGINAL_PRICE",
    "transforms": [
     "int"
    ]
   },
   "product.country": {
    "default": "Česko"
   },
   "product.destination": {
    "path": "CITIES/CITY",
    "transforms": [
     "trim"
    ]
   },
   "product.place": {
    "path": "PROVIDER/PROVIDER_ADDRESS",
    "transforms": [
     "trim"
    ]
   },
   "product.images": {
    "path": "IMAGES/IMAGE",
    "multiple": true,
    "transforms": [
     "img_url"
    ]
   },
   "product.date_from": {
    "path": "VOUCHER_START",
    "transforms": [
     "ymd"
    ]
   },
   "product.date_to": {
    "path": "VOUCHER_END",
    "transforms": [
     "ymd"
    ]
   },
   "product._categories": {
    "path": "CATEGORIES/CATEGORY",
    "multiple": true
   }
  }
 },
