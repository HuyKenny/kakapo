---
interface Props { title: string; msgOk?: string | null; msgErr?: string | null }
const { title, msgOk, msgErr } = Astro.props;
const nav = [['/admin/', 'Feedy'], ['/admin/hotely/', 'Hotely a nabídky'], ['/admin/texty/', 'Texty a SEO'], ['/admin/presmerovani/', 'Přesměrování'], ['/admin/audit/', 'Audit']];
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} – administrace Kakapo</title>
  <style>
    body{font:16px/1.5 system-ui,sans-serif;margin:0;color:#1a1a1a;background:#f6f6f4}
    header{background:#1f3a34;color:#fff;padding:.75rem 1rem}
    nav a{color:#fff;margin-right:1rem}
    nav a[aria-current=page]{text-decoration:underline}
    main{max-width:1100px;margin:1rem auto;padding:0 1rem}
    table{border-collapse:collapse;width:100%;background:#fff}
    th,td{border:1px solid #ddd;padding:.4rem .6rem;text-align:left;vertical-align:top;font-size:.92rem}
    label{display:block;margin:.6rem 0 .2rem;font-weight:600}
    input,select,textarea{font:inherit;padding:.4rem;width:100%;max-width:42rem;box-sizing:border-box}
    textarea{min-height:10rem}
    button{font:inherit;padding:.4rem .9rem;cursor:pointer}
    .ok{background:#e3f4e6;border:1px solid #9bc9a3;padding:.6rem;margin:.6rem 0}
    .err{background:#fde8e8;border:1px solid #d99;padding:.6rem;margin:.6rem 0}
    .inline{display:inline}
    small{color:#555}
  </style>
</head>
<body>
  <header><nav aria-label="Administrace">{nav.map(([h, t]) => <a href={h} aria-current={Astro.url.pathname === h ? 'page' : undefined}>{t}</a>)}</nav></header>
  <main>
    <h1>{title}</h1>
    {msgOk && <p class="ok" role="status">{msgOk}</p>}
    {msgErr && <p class="err" role="alert">{msgErr}</p>}
    <slot />
  </main>
</body>
</html>
