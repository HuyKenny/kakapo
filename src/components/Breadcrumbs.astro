---
interface Crumb { label: string; url?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
{items.length > 0 && (
<nav class="mb-4" aria-label="Drobečková navigace">
	<ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-500">
		{items.map((c, i) => (
			<>
				{i > 0 && (
					<li aria-hidden="true">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300"><path d="m9 18 6-6-6-6"/></svg>
					</li>
				)}
				<li>
					{c.url ? <a href={c.url} class="transition hover:text-ink">{c.label}</a> : <span class="font-medium text-ink" aria-current="page">{c.label}</span>}
				</li>
			</>
		))}
	</ol>
</nav>
)}
