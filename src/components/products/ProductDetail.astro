---
import Breadcrumbs from '../Breadcrumbs.astro';
import ProductCard from './ProductCard.astro';
import { categoryIcon } from '../../lib/products/data';
import { termGoUrl, termLabel } from '../../lib/products/content';
import type { DetailData } from '../../lib/products/route';
import { formatDate, formatPrice, imgUrl, nightsLabel } from '../../lib/helpers';
interface Props { data: DetailData }
const { data } = Astro.props;
const d = data.detail; const p = d.p;
const price = formatPrice(p.price);
const galleryCfg = JSON.stringify({ images: d.images.map((u) => imgUrl(u, 1280, 78)), name: d.title });
const benefits = [
	{ t: 'Ověřený partner', d: d.plabel || 'česká CK', p: '<path d="m9 12 2 2 4-4"/><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/>' },
	{ t: 'Rezervace u pořadatele', d: 'bez prostředníka', p: '<path d="M20 6 9 17l-5-5"/>' },
	{ t: 'Bez příplatků', d: 'cenu neměníme', p: '<circle cx="12" cy="12" r="9"/><path d="M9 12h6M12 9v6"/>' },
	{ t: d.rows.length > 1 ? `${d.rows.length} termínů` : 'Aktuální nabídka', d: 'k výběru', p: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>' },
];
const seoTrim = (t: string, n: number) => t.replace(/<[^>]*>/g, ' ').split(/\s+/).filter(Boolean).slice(0, n).join(' ') + (t.replace(/<[^>]*>/g, ' ').split(/\s+/).filter(Boolean).length > n ? '…' : '');
const goAttrs = { 'data-kakapo-partner': p.partner_slug ?? '', 'data-kakapo-price': String(Math.trunc(p.price ?? 0)), target: '_blank', rel: 'nofollow sponsored noopener' };
const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>';
---
<main class="container-k py-8">
	<Breadcrumbs items={data.meta.breadcrumbs} />

	<div class="mb-2 flex flex-wrap items-center gap-2">
		<a href={`/${d.cat.path}/`} class="inline-flex items-center gap-1.5 rounded-full bg-mist px-3 py-1 text-xs font-semibold text-ink transition hover:bg-coral hover:text-white">
			<span set:html={categoryIcon(d.type)} />
			{d.cat.label}
		</a>
		{d.plabel !== '' && <span class="text-sm text-slate-400">Nabízí {d.plabel}</span>}
	</div>
	<h1 class="font-display text-3xl font-bold leading-tight tracking-tightish text-ink sm:text-4xl">{d.title}</h1>
	{d.place !== '' && (
		<p class="mt-2 flex items-center gap-1.5 text-slate-500">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.2-7-11a7 7 0 1 1 14 0c0 5.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
			{d.place}
		</p>
	)}

	<div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-[1fr_360px]">
		<div>
			{d.images.length > 0 && (
				<div x-data={`kakapoGallery(${galleryCfg})`} class="mb-8">
					<button type="button" class="block w-full overflow-hidden rounded-3xl bg-mist shadow-card" @click="lightbox = true" aria-label="Zvětšit fotku">
						<img x-bind:src="images[idx]" src={imgUrl(d.images[0], 1280, 78)} alt={d.title} decoding="async" fetchpriority="high" class="aspect-[16/9] w-full object-cover sm:aspect-[16/8]">
					</button>
					{d.images.length > 1 && (
						<div class="mt-3 grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-8">
							{d.images.slice(0, 8).map((img, gi) => (
								<button type="button" class="overflow-hidden rounded-xl ring-2 ring-transparent transition focus:ring-ink" @click={`idx = ${gi}`} x-bind:class={`idx === ${gi} ? 'ring-ink' : 'hover:ring-line'`} aria-label={`Fotka ${gi + 1}`}>
									<img src={imgUrl(img, 320, 70)} alt="" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover">
								</button>
							))}
						</div>
					)}
					<div x-show="lightbox" x-cloak class="fixed inset-0 z-[60] flex items-center justify-center bg-black/90 p-4" @click="lightbox = false" @keydown.escape.window="lightbox = false" @keydown.arrow-right.window="next()" @keydown.arrow-left.window="prev()">
						<button type="button" class="absolute right-4 top-4 text-white/80 hover:text-white" @click="lightbox = false" aria-label="Zavřít">
							<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
						</button>
						<button type="button" class="absolute left-4 text-white/80 hover:text-white" @click.stop="prev()" aria-label="Předchozí">
							<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
						</button>
						<img x-bind:src="images[idx]" alt="" class="max-h-[85vh] max-w-full rounded-lg object-contain" @click.stop>
						<button type="button" class="absolute right-4 text-white/80 hover:text-white" @click.stop="next()" aria-label="Další">
							<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
						</button>
						<span class="absolute bottom-4 text-sm text-white/70" x-text="(idx + 1) + ' / ' + images.length"></span>
					</div>
				</div>
			)}

			<div class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
				{benefits.map((bf) => (
					<div class="flex items-start gap-2.5 rounded-2xl border border-line bg-white p-3.5">
						<span class="mt-0.5 shrink-0 text-leaf"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={bf.p} /></span>
						<span class="min-w-0">
							<span class="block text-sm font-semibold text-ink">{bf.t}</span>
							<span class="block truncate text-xs text-slate-500">{bf.d}</span>
						</span>
					</div>
				))}
			</div>

			{d.descParagraphs.length > 0 && (
				<section class="mb-8">
					<h2 class="mb-3 h-section">O nabídce</h2>
					<div class="prose-kakapo">
						{d.descParagraphs.map((para, i) => <p class={i === 0 ? 'text-lg leading-relaxed text-slate-700' : 'mt-4 text-[15px] leading-relaxed text-slate-600'}>{para}</p>)}
					</div>
				</section>
			)}

			<section class="mb-8 grid gap-4 md:grid-cols-2">
				<div class="rounded-2xl border border-line bg-white p-5 shadow-card">
					<h2 class="mb-3 font-display text-xl font-bold tracking-tightish text-ink">Pro koho se nabídka hodí</h2>
					<ul class="space-y-2.5 text-[15px] leading-relaxed text-slate-600">
						{d.fitPoints.map((t) => <li class="flex gap-2.5"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-coral-bright" aria-hidden="true"></span><span>{t}</span></li>)}
					</ul>
				</div>
				<div class="rounded-2xl border border-line bg-white p-5 shadow-card">
					<h2 class="mb-3 font-display text-xl font-bold tracking-tightish text-ink">Co zkontrolovat před rezervací</h2>
					<ul class="space-y-2.5 text-[15px] leading-relaxed text-slate-600">
						{d.checkPoints.map((t) => <li class="flex gap-2.5"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-coral" aria-hidden="true"></span><span>{t}</span></li>)}
					</ul>
				</div>
			</section>

			<section class="mb-8" id="terminy">
				<h2 class="mb-4 h-section">Termíny a ceny</h2>
				<div class="overflow-x-auto rounded-2xl border border-line bg-white shadow-card">
					<table class="offers-table">
						<thead>
							<tr><th scope="col">Termín</th><th scope="col">Nocí</th><th scope="col">Cena/os.</th><th scope="col"><span class="sr-only">Akce</span></th></tr>
						</thead>
						<tbody>
							{d.rows.map((t, ti) => (
								<tr>
									<td data-label="Termín"><span class="block whitespace-nowrap font-medium text-ink">{termLabel(t)}</span></td>
									<td data-label="Nocí">{(t.nights ?? 0) > 0 ? nightsLabel(t.nights!) : '—'}</td>
									<td data-label="Cena/os."><span class="whitespace-nowrap text-lg font-bold text-coral-dark">{formatPrice(t.price)}</span></td>
									<td class="offers-cta"><a class="btn-primary btn-sm whitespace-nowrap" href={termGoUrl(d, ti)} data-kakapo-partner={p.partner_slug ?? ''} data-kakapo-price={String(Math.trunc(t.price ?? p.price ?? 0))} target="_blank" rel="nofollow sponsored noopener">Zobrazit nabídku</a></td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>

			{d.cat.seo_text && (
				<section class="rounded-2xl bg-mist/70 p-6">
					<h2 class="mb-2 font-display text-xl font-bold tracking-tightish text-ink">Proč {d.cat.label.toLowerCase()} přes Kakapo.cz</h2>
					<p class="text-[15px] leading-relaxed text-slate-600">{seoTrim(d.cat.seo_text, 42)}</p>
				</section>
			)}

			{d.related.length > 0 && (
				<section class="mt-8 rounded-2xl border border-line bg-white p-5 shadow-card">
					<h2 class="mb-3 font-display text-xl font-bold tracking-tightish text-ink">Související výběr</h2>
					<div class="flex flex-wrap gap-2">
						{d.related.map((l) => (
							<a href={l.url} class="inline-flex items-center gap-1.5 rounded-full border border-line bg-mist px-3 py-1.5 text-sm font-semibold text-ink transition hover:border-ink hover:bg-coral hover:text-white">
								{l.label}
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
							</a>
						))}
					</div>
				</section>
			)}

			{d.faqs.length > 0 && (
				<section class="mt-8">
					<h2 class="mb-4 h-section">Časté otázky</h2>
					<div class="space-y-3">
						{d.faqs.map((f) => (
							<details class="group rounded-2xl border border-line bg-white p-5 shadow-card">
								<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
									<span>{f.q}</span>
									<span class="text-coral transition group-open:rotate-45" aria-hidden="true">+</span>
								</summary>
								<p class="mt-3 text-[15px] leading-relaxed text-slate-600">{f.a}</p>
							</details>
						))}
					</div>
				</section>
			)}
		</div>

		<aside class="lg:sticky lg:top-24 lg:self-start" aria-label="Souhrn nabídky">
			<div class="rounded-2xl border border-line bg-white p-5 shadow-card">
				<p class="text-sm text-slate-500">Cena od</p>
				<p class="whitespace-nowrap font-display text-4xl font-bold text-ink">{price}</p>
				<p class="mt-0.5 text-xs text-slate-400">za osobu</p>
				<dl class="mt-4 space-y-2.5 border-t border-line pt-4 text-sm">
					{p.nights ? <div class="flex items-center justify-between gap-2"><dt class="text-slate-500">Délka</dt><dd class="font-semibold text-ink">{nightsLabel(p.nights)}</dd></div> : null}
					{d.rows.length > 1
						? <div class="flex items-center justify-between gap-2"><dt class="text-slate-500">Termínů</dt><dd class="font-semibold text-ink">{d.rows.length} na výběr</dd></div>
						: p.date_from ? <div class="flex items-center justify-between gap-2"><dt class="text-slate-500">Nejbližší termín</dt><dd class="font-semibold text-ink">{formatDate(p.date_from)}</dd></div> : null}
					{p.meal ? <div class="flex items-center justify-between gap-2"><dt class="text-slate-500">Strava</dt><dd class="font-semibold text-ink">{p.meal}</dd></div> : null}
					{d.plabel !== '' ? <div class="flex items-center justify-between gap-2"><dt class="text-slate-500">Pořadatel</dt><dd class="font-semibold text-ink">{d.plabel}</dd></div> : null}
				</dl>
				<a href={d.goUrl} {...goAttrs} class="btn-sun btn-lg mt-5 w-full">
					Zobrazit u partnera
					<Fragment set:html={arrow} />
				</a>
				<p class="mt-3 flex items-center justify-center gap-1.5 text-center text-xs text-slate-400">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/></svg>
					Rezervace bezpečně u {d.plabel || 'partnera'}
				</p>
			</div>
		</aside>
	</div>

	{data.similar.length > 0 && (
		<section class="mt-14">
			<h2 class="mb-6 h-section">Mohlo by se vám líbit</h2>
			<div class="grid grid-cols-1 gap-x-5 gap-y-9 sm:grid-cols-2 lg:grid-cols-4">
				{data.similar.map((s) => <ProductCard p={s} />)}
			</div>
		</section>
	)}

	<div class="h-20 lg:hidden" aria-hidden="true"></div>
</main>

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-white/95 px-4 py-3 shadow-[0_-4px_16px_rgba(0,0,0,0.08)] backdrop-blur lg:hidden">
	<div class="flex items-center justify-between gap-3">
		<div class="leading-tight">
			<span class="block text-xs text-slate-500">Cena od</span>
			<span class="block text-lg font-extrabold text-ink">{price}</span>
		</div>
		<a href={d.goUrl} {...goAttrs} class="btn-sun shrink-0">Zobrazit u partnera</a>
	</div>
</div>
