---
import Breadcrumbs from '../Breadcrumbs.astro';
import ProductCard from './ProductCard.astro';
import { CENA_BANDS, categoryUrl } from '../../lib/products/route';
import type { CategoryView } from '../../lib/products/route';
import { fixHtml } from '../../lib/products/data';
import { partnerLabel } from '../../lib/helpers';
interface Props { view: CategoryView }
const { view } = Astro.props;
const { cat, base, sort, zeme, partner, q, cena, lok, typ, page, hasFilters, res, opts, summary, cur, type } = view;
const u = (o: Record<string, string | number>) => categoryUrl(base, cur, o);
const total = res.total; const pages = res.pages;
const nab = total === 1 ? 'nabídka' : total >= 2 && total <= 4 ? 'nabídky' : 'nabídek';
const nf = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
const wpautop = (t: string) => String(t ?? '').split(/\n\s*\n/).map((s) => s.trim()).filter(Boolean).map((s) => `<p>${s.replace(/\n/g, '<br>')}</p>`).join('\n');
// wide window as in search.php: 1 … p-2..p+2 … jumps of 10 … last
const items = new Set<number>([1, pages]);
for (let n = Math.max(2, page - 2); n <= Math.min(pages - 1, page + 2); n++) items.add(n);
for (let n = 10; n < pages; n += 10) items.add(n);
const pg = [...items].filter((n) => n >= 1 && n <= pages).sort((a, b) => a - b);
const pgLink = (n: number) => (n <= 1 ? u({ strana: '' }) : u({ strana: n }));
const faqs = (Array.isArray(cat.faqs) ? cat.faqs : []).filter((f) => String(f?.q ?? '').trim() !== '' && String(f?.a ?? '').trim() !== '');
let prev = 0;
---
<main class="container-k py-8">
	<Breadcrumbs items={view.meta.breadcrumbs} />

	<header class="mb-7 max-w-3xl">
		<span class="eyebrow">Objevte · {cat.label}</span>
		<h1 class="mt-2 font-display text-3xl font-extrabold tracking-[-0.03em] text-ink sm:text-[2.6rem] sm:leading-tight">{cat.label}</h1>
		<p class="mt-3 text-lg leading-relaxed text-slate-600">{cat.intro}</p>
	</header>

	{summary.length > 0 && (
		<section class="mb-6 grid grid-cols-2 gap-2 sm:gap-3 lg:grid-cols-4" aria-label="Rychlý přehled kategorie">
			{summary.slice(0, 4).map((c) => (
				<div class="rounded-2xl border border-line bg-white p-3 shadow-soft sm:p-4">
					<p class="text-xs font-bold text-slate-500">{c.label}</p>
					<p class="mt-1 text-base font-bold leading-snug text-ink">{c.value}</p>
				</div>
			))}
		</section>
	)}

	<form method="get" action={base} class="mb-6 rounded-2xl border border-line bg-white p-4 shadow-soft sm:p-5">
		<div class="flex flex-col gap-3 sm:flex-row sm:items-center">
			<div class="relative flex-1">
				<svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
				<input type="search" name="q" value={q} placeholder="Hledat destinaci nebo název…" class="input pl-10">
			</div>
			<div class="flex items-center gap-2">
				<label for="kakapo-sort" class="shrink-0 text-sm text-slate-500">Řadit:</label>
				<select id="kakapo-sort" name="sort" class="select" onchange="this.form.submit()">
					<option value="price" selected={sort === 'price'}>Nejlevnější</option>
					<option value="price_desc" selected={sort === 'price_desc'}>Nejdražší</option>
					<option value="date" selected={sort === 'date'}>Nejbližší termín</option>
					<option value="title" selected={sort === 'title'}>Podle názvu</option>
				</select>
				<button type="submit" class="btn-primary btn-sm shrink-0">Filtrovat</button>
			</div>
		</div>

		{opts.countries.length > 1 && type !== 'wellness' && (
			<div class="mt-4 flex flex-wrap items-center gap-2">
				<a href={u({ zeme: '' })} class={`chip ${zeme === '' ? 'chip-active' : ''}`}>Všechny země</a>
				{opts.countries.filter((c) => c.cnt >= 1).map((c) => (
					<a href={u({ zeme: c.country_slug })} class={`chip ${zeme === c.country_slug ? 'chip-active' : ''}`}>{c.country} <span class="text-xs opacity-60">{c.cnt}</span></a>
				))}
			</div>
		)}

		{type === 'wellness' && opts.places.length > 1 && (
			<div class="mt-4 flex flex-wrap items-center gap-2">
				<span class="mr-1 text-sm font-medium text-slate-500">Lokalita:</span>
				<a href={u({ lokalita: '' })} class={`chip ${lok === '' ? 'chip-active' : ''}`}>Všechny</a>
				{opts.places.map((p) => (
					<a href={u({ lokalita: p.place })} class={`chip ${lok === p.place ? 'chip-active' : ''}`}>{p.place} <span class="text-xs opacity-60">{p.cnt}</span></a>
				))}
			</div>
		)}

		{type === 'wellness' && opts.kinds.length > 1 && (
			<div class="mt-3 flex flex-wrap items-center gap-2">
				<span class="mr-1 text-sm font-medium text-slate-500">Typ:</span>
				<a href={u({ typ: '' })} class={`chip ${typ === '' ? 'chip-active' : ''}`}>Vše</a>
				{opts.kinds.map((k) => (
					<a href={u({ typ: k.type_raw })} class={`chip ${typ === k.type_raw ? 'chip-active' : ''}`}>{k.type_raw} <span class="text-xs opacity-60">{k.cnt}</span></a>
				))}
			</div>
		)}

		<div class="mt-3 flex flex-wrap items-center gap-2">
			{Object.entries(CENA_BANDS).map(([bk, b]) => (
				<a href={u({ cena: cena === bk ? '' : bk })} class={`chip ${cena === bk ? 'chip-active' : ''}`}>{b.label}</a>
			))}
			{opts.partners.length > 1 && (
				<>
					<span class="mx-1 hidden h-5 w-px bg-line sm:inline-block"></span>
					<select name="partner" class="select w-auto" onchange="this.form.submit()">
						<option value="">Všichni partneři</option>
						{opts.partners.map((pa) => <option value={pa.partner_slug} selected={partner === pa.partner_slug}>{partnerLabel(pa.partner_slug)} ({pa.cnt})</option>)}
					</select>
				</>
			)}
			{hasFilters && (
				<a href={base} class="ml-auto inline-flex items-center gap-1 text-sm font-medium text-slate-500 transition hover:text-ink hover:underline">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
					Zrušit filtry
				</a>
			)}
		</div>
		{/* keep active filters that have no input of their own when the form is submitted */}
		{cena !== '' && <input type="hidden" name="cena" value={cena} />}
		{zeme !== '' && !view.landing && <input type="hidden" name="zeme" value={zeme} />}
		{lok !== '' && !view.landing && <input type="hidden" name="lokalita" value={lok} />}
		{typ !== '' && !view.landing && <input type="hidden" name="typ" value={typ} />}
	</form>

	<p class="mb-5 text-sm text-slate-500">
		<span class="font-semibold text-ink">{nf(total)}</span> {nab} {hasFilters ? 'odpovídá filtru' : 'v této landing page'}
	</p>

	{res.products.length > 0 ? (
		<>
			<div class="grid grid-cols-1 gap-x-5 gap-y-9 sm:grid-cols-2 lg:grid-cols-4">
				{res.products.map((p) => <ProductCard p={p} />)}
			</div>
			{pages > 1 && (
				<nav class="mt-8 flex flex-wrap items-center justify-center gap-2" aria-label="Stránkování">
					{page > 1 && (
						<a class="page-link" href={pgLink(page - 1)} aria-label="Předchozí stránka">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
						</a>
					)}
					{pg.map((n) => {
						const gap = n - prev > 1; prev = n;
						return (
							<>
								{gap && <span class="px-1 text-slate-400" aria-hidden="true">…</span>}
								{n === page ? <span class="page-link page-link-active" aria-current="page">{n}</span> : <a class="page-link" href={pgLink(n)}>{n}</a>}
							</>
						);
					})}
					{page < pages && (
						<a class="page-link" href={pgLink(page + 1)} aria-label="Další stránka">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
						</a>
					)}
				</nav>
			)}
		</>
	) : (
		<div class="rounded-2xl border border-line bg-white p-12 text-center shadow-soft">
			<p class="text-lg font-semibold text-ink">{hasFilters ? 'Nic neodpovídá filtru' : 'Zatím tu nic není'}</p>
			<p class="mt-1 text-sm text-slate-500">{hasFilters ? 'Zkuste zmírnit filtry nebo je zrušit.' : 'Nabídky v této kategorii připravujeme. Zkuste to prosím později.'}</p>
			{hasFilters && <a href={base} class="btn-ghost mt-4">Zrušit filtry</a>}
		</div>
	)}

	{cat.seo_text && (
		<section class="mt-16 border-t border-line pt-10">
			<div class="prose-kakapo max-w-5xl text-slate-600" set:html={fixHtml(cat.seo_text)} />
		</section>
	)}

	{faqs.length > 0 && (
		<section class="mt-14 border-t border-line pt-10">
			<div class="max-w-4xl">
				<h2 class="h-section">Časté otázky</h2>
				<div class="mt-5 divide-y divide-line rounded-2xl border border-line bg-white shadow-soft">
					{faqs.map((f) => (
						<details class="group p-5" open>
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
								{f.q}
								<span class="text-xl leading-none text-slate-400 transition group-open:rotate-45">+</span>
							</summary>
							<div class="mt-3 text-sm leading-relaxed text-slate-600" set:html={wpautop(f.a)} />
						</details>
					))}
				</div>
			</div>
		</section>
	)}
</main>
