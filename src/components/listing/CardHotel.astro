---
// Hotel card. Markup MUST stay 1:1 with renderCard() in public/wp-content/kakapo-assets/js/frontend.js.
import { countryFlagHtml, formatPrice } from '../../lib/helpers';
import { cardModel, ratingStr, srcsetRaw } from '../../lib/listing/html';
import type { HotelRow } from '../../lib/search';
import { selectionQuery } from '../../lib/hotel/selection';
interface Props { hotel: HotelRow; eager?: boolean }
// eager = above-the-fold card: its photo is the LCP element on listings, so it must not be lazy-loaded
const { hotel, eager = false } = Astro.props;
const m = cardModel(hotel, selectionQuery(Astro.url.searchParams));
const flag = countryFlagHtml(String(hotel.country ?? ''), String(hotel.country_slug ?? ''));
const srcset = m.image ? srcsetRaw(m.image, 640) : '';
const star = '<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.26 6.86.83-5.07 4.7 1.35 6.77L12 17.2l-6.04 3.36 1.35-6.77-5.07-4.7 6.86-.83z"/></svg>';
import { imgUrl } from '../../lib/helpers';
---
<article class="card-k group">
	<div class="card-k-img">
		{m.image ? (
			<img src={imgUrl(m.image, 640)} srcset={srcset || undefined} sizes="(min-width:1280px) 22vw, (min-width:1024px) 30vw, (min-width:640px) 45vw, 92vw" alt={hotel.name} width="640" height="480" {...(eager ? { fetchpriority: 'high' } : { loading: 'lazy' })} decoding="async" onerror="this.style.display='none'">
		) : (
			<div class="flex h-full w-full items-center justify-center text-slate-300" aria-hidden="true">
				<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v14M9 9h1m4 0h1M9 13h1m4 0h1M9 17h1m4 0h1"/></svg>
			</div>
		)}
		<div class="absolute left-3 top-3 flex flex-wrap gap-1.5">
			{m.isLm && <span class="badge badge-lm">Last minute</span>}
			{m.discount !== null && m.discount > 0 && <span class="badge badge-sale">−{m.discount} %</span>}
		</div>
	</div>
	<div class="flex flex-1 flex-col pt-3">
		<div class="flex items-start justify-between gap-3">
			<h3 class="text-[15px] font-bold leading-snug text-ink">
				<a href={m.url} class="text-ink no-underline after:absolute after:inset-0 after:z-10 after:rounded-2xl focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-ink">{hotel.name}</a>
			</h3>
			{m.rating !== null && <span class="rating-badge" aria-label={`Hodnocení ${ratingStr(m.rating)} z 10`}>{ratingStr(m.rating)}</span>}
		</div>
		<p class="mt-0.5 flex items-center gap-1.5 text-sm text-slate-500">
			<Fragment set:html={flag} />
			<span class="truncate">{hotel.country}{hotel.destination ? ` · ${hotel.destination}` : ''}</span>
			{m.stars > 0 && (
				<span class="ml-auto inline-flex shrink-0 items-center gap-px text-amber-400" role="img" aria-label={`${m.stars} z 5 hvězdiček`}>
					<Fragment set:html={star.repeat(m.stars)} />
				</span>
			)}
		</p>
		{m.bestBits && <p class="text-sm text-slate-500">{m.bestBits}</p>}
		<div class="mt-auto pt-2">
			{m.price !== null && (
				<p class="text-[15px] text-ink">
					<span class="text-slate-500">od</span>
					<strong class="whitespace-nowrap font-extrabold">{formatPrice(m.price)}</strong>
					<span class="text-slate-500">/ os.</span>
					{m.priceOriginal !== null && <span class="ml-1 whitespace-nowrap text-sm text-slate-400 line-through">{formatPrice(m.priceOriginal)}</span>}
				</p>
			)}
			{m.partners > 1 && <p class="text-sm font-semibold text-coral-dark">Porovnat {m.partners} {m.partners >= 5 ? 'nabídek' : 'nabídky'}</p>}
			{m.cta && <a href={m.cta.href} rel="nofollow sponsored noopener" class="card-cta" data-affiliate="1" data-placement="card">Zobrazit u {m.cta.partner}</a>}
		</div>
	</div>
</article>
