{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = local development only (miniflare, local D1/R2, no real data).
  // Staging/production are added when the D1 databases exist (database_id comes from `wrangler d1 create`).
  "name": "kakapo-local",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "directory": "./dist/client", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "kakapo-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "kakapo-snapshots-local" }],
  "ratelimits": [
    { "name": "RL_GO", "namespace_id": "73001", "simple": { "limit": 40, "period": 60 } },
    { "name": "RL_ADMIN", "namespace_id": "73002", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_SEARCH", "namespace_id": "73003", "simple": { "limit": 90, "period": 60 } }
  ],
  "vars": { "ENVIRONMENT": "local", "SITE_URL": "http://localhost:8791", "ALLOWED_HOSTS": "localhost,127.0.0.1" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "env": {
    // Static build (Cloudflare Workers Free, 2026-11): rendered locally under `wrangler dev --local` over the SQLite state and
    // frozen into static files (scripts/static/build.py). Never deployed itself. Same vars as production so the HTML is identical;
    // no host allow-list, rate limits or services (local crawl).
    "render": {
      "name": "kakapo-render",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [{ "binding": "DB", "database_name": "kakapo-render", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "kakapo-snapshots-render" }],
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_URL": "https://kakapo.cz",
        "ALLOWED_HOSTS": "",
        "REQUIRE_ACCESS_EVERYWHERE": "0",
        "ANALYTICS_ENABLED": "1",
        "ACCESS_TEAM_DOMAIN": "proud-pine-5d46.cloudflareaccess.com"
      }
    },
    "staging": {
      "name": "kakapo-staging",
      // Only reachable as kakapo-staging.huy-kenny.workers.dev, behind Cloudflare Access (whole host);
      // the Worker re-checks the Access JWT on every request (REQUIRE_ACCESS_EVERYWHERE).
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [{ "binding": "DB", "database_name": "kakapo-staging", "database_id": "ad3a4546-c879-4fc2-85e2-80670c43ab84", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "kakapo-snapshots-staging" }],
      "services": [{ "binding": "IMPORTER", "service": "kakapo-import-staging" }],
      "ratelimits": [
        { "name": "RL_GO", "namespace_id": "73011", "simple": { "limit": 40, "period": 60 } },
        { "name": "RL_ADMIN", "namespace_id": "73012", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_SEARCH", "namespace_id": "73013", "simple": { "limit": 90, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_URL": "https://kakapo-staging.huy-kenny.workers.dev",
        "ALLOWED_HOSTS": "kakapo-staging.huy-kenny.workers.dev",
        "REQUIRE_ACCESS_EVERYWHERE": "1",
        "ANALYTICS_ENABLED": "0",
        "ACCESS_TEAM_DOMAIN": "proud-pine-5d46.cloudflareaccess.com"
      }
      // secrets (wrangler secret put --env staging): ACCESS_AUD, IP_HASH_SALT, IMPORT_SHARED_SECRET
    }
    ,
    "production": {
      "name": "kakapo",
      // Routes are added at the cutover (Workers routes on the existing proxied DNS records; deleting them is the instant rollback).
      // workers_dev is on only while verifying the production Worker with production data before the routes exist.
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [{ "binding": "DB", "database_name": "kakapo-production", "database_id": "302b7cb9-53f0-47f3-bb6a-239a7402334f", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "kakapo-snapshots" }],
      "services": [{ "binding": "IMPORTER", "service": "kakapo-import" }],
      "ratelimits": [
        { "name": "RL_GO", "namespace_id": "73021", "simple": { "limit": 40, "period": 60 } },
        { "name": "RL_ADMIN", "namespace_id": "73022", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_SEARCH", "namespace_id": "73023", "simple": { "limit": 90, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_URL": "https://kakapo.cz",
        "ALLOWED_HOSTS": "kakapo.cz,www.kakapo.cz,kakapo.huy-kenny.workers.dev",
        "REQUIRE_ACCESS_EVERYWHERE": "0",
        "ANALYTICS_ENABLED": "1",
        "ACCESS_TEAM_DOMAIN": "proud-pine-5d46.cloudflareaccess.com"
      }
    }
  }
}
